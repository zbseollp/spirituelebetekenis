---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Sidebar from "../../../components/Sidebar.astro";
import ArchiveList from "../../../components/ArchiveList.astro";
import Pagination from "../../../components/Pagination.astro";
import { allPosts, chunk } from "../../../lib/index";
import { site, POSTS_PER_PAGE as PER } from "../../../data/site";

export function getStaticPaths() {
  const pages = chunk(allPosts, PER);
  // Pagina 1 is /blog/ zelf; deze route begint bij 2.
  return pages.slice(1).map((items, i) => ({
    params: { page: String(i + 2) },
    props: { n: i + 2, total: pages.length, items },
  }));
}

const { n, total, items } = Astro.props;
---
<BaseLayout
  title={`Blog - pagina ${n}${site.titleSuffix}`}
  canonical={`${site.domain}/blog/page/${n}/`}
  noindex
>
  <div class="wrap layout">
    <div>
      <h1>Blog</h1>
      <p class="archive__meta">Pagina {n} van {total}</p>
      <ArchiveList posts={items} />
      <Pagination current={n} total={total} href={(p) => (p === 1 ? "/blog/" : `/blog/page/${p}/`)} />
    </div>
    <Sidebar />
  </div>
</BaseLayout>
