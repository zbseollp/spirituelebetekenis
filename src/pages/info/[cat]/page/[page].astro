---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Sidebar from "../../../../components/Sidebar.astro";
import ArchiveList from "../../../../components/ArchiveList.astro";
import Pagination from "../../../../components/Pagination.astro";
import { categories, postsInCategory, chunk } from "../../../../lib/index";
import { site, POSTS_PER_PAGE as PER } from "../../../../data/site";

export function getStaticPaths() {
  const paths = [];
  for (const c of categories) {
    const pages = chunk(postsInCategory(c.slug), PER);
    for (let i = 1; i < pages.length; i++) {
      paths.push({
        params: { cat: c.slug, page: String(i + 1) },
        props: { category: c, n: i + 1, total: pages.length, items: pages[i] },
      });
    }
  }
  return paths;
}

const { category, n, total, items } = Astro.props;
---
<BaseLayout
  title={`${category.name} Archieven - pagina ${n}${site.titleSuffix}`}
  canonical={`${site.domain}/info/${category.slug}/page/${n}/`}
  noindex
>
  <div class="wrap layout">
    <div>
      <h1>{category.name}</h1>
      <p class="archive__meta">Pagina {n} van {total}</p>
      <ArchiveList posts={items} />
      <Pagination
        current={n}
        total={total}
        href={(p) => (p === 1 ? `/info/${category.slug}/` : `/info/${category.slug}/page/${p}/`)}
      />
    </div>
    <Sidebar />
  </div>
</BaseLayout>
