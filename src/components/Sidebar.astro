---
import { sidebarPromos, affiliateRedirects } from "../data/site";
import { allPosts, categories, postsInCategory } from "../lib/index";

// Dezelfde zijbalk als de oude site: eerst de promotieblokken, dan de
// recente artikelen en de categorieën.
const recent = allPosts.slice(0, 8);
const external = (href: string) => Boolean(affiliateRedirects[href]);
---
<aside class="sidebar" aria-label="Zijbalk">
  {sidebarPromos.map((promo) => (
    <section class="widget widget--promo">
      {promo.image && (
        <a
          class="widget__media"
          href={promo.href}
          tabindex="-1"
          aria-hidden="true"
          rel={external(promo.href) ? "nofollow sponsored noopener" : undefined}
        >
          <img src={promo.image} alt="" loading="lazy" decoding="async" />
        </a>
      )}
      <h2 class="widget__title">{promo.title}</h2>
      <div class="widget__body">
        {promo.text && <p>{promo.text}</p>}
        <a
          class="button"
          href={promo.href}
          rel={external(promo.href) ? "nofollow sponsored noopener" : undefined}
        >
          {promo.button}
        </a>
      </div>
    </section>
  ))}

  <section class="widget">
    <h2 class="widget__title">Recente artikelen</h2>
    <div class="widget__body">
      <ul>
        {recent.map((post) => (
          <li><a href={`/${post.slug}/`}>{post.title}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="widget">
    <h2 class="widget__title">Categorieën</h2>
    <div class="widget__body">
      <ul>
        {categories.map((c) => (
          <li>
            <a href={`/info/${c.slug}/`}>{c.name}</a>
            <span class="archive__meta"> ({postsInCategory(c.slug).length})</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</aside>
