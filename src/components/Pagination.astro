---
interface Props {
  current: number;
  total: number;
  href: (page: number) => string;
}
const { current, total, href } = Astro.props;

// Bij 170 pagina's is een volledige nummerreeks onbruikbaar; toon de randen en
// een venster rond de huidige pagina, net als de oude site deed.
const span = 2;
const numbers: (number | "gap")[] = [];
for (let n = 1; n <= total; n++) {
  if (n === 1 || n === total || Math.abs(n - current) <= span) numbers.push(n);
  else if (numbers[numbers.length - 1] !== "gap") numbers.push("gap");
}
---
{total > 1 && (
  <nav class="pagination" aria-label="Paginanavigatie">
    {current > 1 && <a href={href(current - 1)} rel="prev">Vorige</a>}
    {numbers.map((n) =>
      n === "gap"
        ? <span aria-hidden="true">…</span>
        : n === current
          ? <span aria-current="page">{n}</span>
          : <a href={href(n)}>{n}</a>
    )}
    {current < total && <a href={href(current + 1)} rel="next">Volgende</a>}
  </nav>
)}
