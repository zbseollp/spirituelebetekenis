---
import { site, nav } from "../data/site";
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  canonical,
  image,
  type = "website",
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical || new URL(Astro.url.pathname, site.domain).href;
const ogImage = new URL(image || site.logo, site.domain).href;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="nl-NL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/wp-content/uploads/2023/04/cropped-logo-spirituelebetekenis.com_.png" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="nl_NL" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Lora:wght@500;600&display=swap"
    />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/feed/" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Ga naar de inhoud</a>

    <header class="site-header" id="site-header">
      <div class="wrap site-header__inner">
        <a class="site-header__logo" href="/" aria-label={site.name}>
          <img src={site.logo} alt={site.name} width="300" height="44" />
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          Menu
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Hoofdmenu">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
                  {item.label}
                </a>
                {item.children && (
                  <ul class="site-nav__sub">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} aria-current={path === child.href ? "page" : undefined}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <h2>{site.name}</h2>
        <nav aria-label="Footermenu">
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/blog/">Alle Berichten</a></li>
            <li><a href="/trainingen/">Trainingen</a></li>
            <li><a href="/over/">Over</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/privacybeleid/">Privacybeleid</a></li>
            <li><a href="/sitemap/">Sitemap</a></li>
          </ul>
        </nav>
      </div>
      <div class="wrap site-footer__legal">
        © {new Date().getFullYear()} {site.name}. Alle rechten voorbehouden.
      </div>
    </footer>

    <script>
      const header = document.getElementById("site-header");
      const toggle = header?.querySelector(".nav-toggle");
      toggle?.addEventListener("click", () => {
        const open = header!.getAttribute("data-open") === "true";
        header!.setAttribute("data-open", String(!open));
        toggle.setAttribute("aria-expanded", String(!open));
      });
    </script>
  </body>
</html>
